t() {
    local key="$1"; shift
    local var="T_${LANG_CODE}_${key}"
    local text="${!var-}"
    if [ -z "$text" ]; then
        var="T_en_${key}"
        text="${!var-}"
    fi
    printf -- "${text:-$key}" "$@"
}
say() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }
notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "BlockPulse Launcher" "$1" >/dev/null 2>&1
    return 0
}

QUIET=0
MODE=run
SCRIPT_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --help|-h) MODE=help ;;
        --version|-V) MODE=version ;;
        --diagnose) MODE=diagnose ;;
        --reset-graphics) MODE=reset ;;
        --quiet|-q) QUIET=1 ;;
        *) SCRIPT_ARGS+=("$arg") ;;
    esac
done

if [ "$MODE" = version ]; then
    say "$(t version_port "$PORT_VERSION")"
    say "$(t version_launcher "$LAUNCHER_VERSION")"
    exit 0
fi
if [ "$MODE" = help ]; then
    say "$(t usage_title "$PORT_VERSION" "$LAUNCHER_VERSION")"
    say "$(t usage_1)"
    say "$(t usage_diagnose)"
    say "$(t usage_reset)"
    say "$(t usage_quiet)"
    say "$(t usage_version)"
    say "$(t usage_help)"
    say ""
    say "$(t usage_installer)"
    exit 0
fi

if [ -z "$APP_DIR" ] || [ ! -f "$APP_DIR/blockpulse-launcher-ui.jar" ]; then
    err "blockpulse-launcher: $(t nojar)"
    notify "$(t nojar)"
    exit 1
fi

if [ "$MODE" = reset ]; then
    rm -f "$GRAPHICS_CACHE"
    say "$(t cleared)"
    exit 0
fi

total_ram_mb() {
    local mb=''
    if [ -r /proc/meminfo ]; then
        mb="$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null)"
    elif command -v sysctl >/dev/null 2>&1; then
        local bytes
        bytes="$(sysctl -n hw.memsize 2>/dev/null || sysctl -n hw.physmem 2>/dev/null || true)"
        case "$bytes" in
            ''|*[!0-9]*) mb='' ;;
            *) mb=$(( bytes / 1048576 )) ;;
        esac
    fi
    case "$mb" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "$mb" ;;
    esac
}

seed_heap() {
    local prefs="$PREFS_FILE" total ram want
    if [ -f "$prefs" ] && grep -q '^[[:space:]]*ramGb=' "$prefs" 2>/dev/null; then
        return 0
    fi
    want="${BLOCKPULSE_RAM_GB:-}"
    case "$want" in
        ''|*[!0-9]*) want='' ;;
    esac
    if [ -z "$want" ]; then
        total="$(total_ram_mb)"
        [ "$total" -gt 0 ] || return 0
        ram=$(( total * 55 / 100 / 1024 ))
        [ "$ram" -lt 2 ] && ram=2
        [ "$ram" -gt 12 ] && ram=12
        want="$ram"
    fi
    [ "$want" -ge 2 ] || want=2
    [ "$want" -le 12 ] || want=12
    if [ -s "$prefs" ]; then
        printf '\nramGb=%s\n' "$want" >>"$prefs" 2>/dev/null
    else
        printf 'ramGb=%s\n' "$want" >"$prefs" 2>/dev/null
    fi
    chmod 600 "$prefs" 2>/dev/null
    return 0
}

seed_heap

java_version_of() {
    local java="$1" release out
    release="$(dirname "$java")/../release"
    if [ -r "$release" ]; then
        out="$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$release" 2>/dev/null | head -1)"
        [ -n "$out" ] && { printf '%s' "$out"; return 0; }
    fi
    out="$("$java" -version 2>&1)"
    printf '%s' "$(printf '%s\n' "$out" | sed -n '1s/.*version "\([^"]*\)".*/\1/p')"
}
java_major_of() {
    printf '%s' "$1" | sed -n 's/^\([0-9][0-9]*\).*/\1/p'
}
looks_unstable() {
    printf '%s' "$1" | grep -qiE 'internal|-ea|snapshot|beta'
}
fx_module_path() {
    local dir="$1" jar module_path=''
    for jar in "$dir"/javafx.*.jar; do
        [ -f "$jar" ] || continue
        case "$jar" in
            */javafx.base.jar|*/javafx.controls.jar|*/javafx.fxml.jar|*/javafx.graphics.jar|*/javafx.media.jar|*/javafx.swing.jar|*/javafx.web.jar)
                module_path="${module_path:+$module_path:}$jar"
                ;;
        esac
    done
    printf '%s' "$module_path"
}
fx_native_path() {
    local dir="$1" candidate
    for candidate in "$dir" /usr/lib/java-openjfx /usr/lib/openjfx; do
        if [ -f "$candidate/libglass.so" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}
list_jvms() {
    local out
    out="$(printf '%s\n' /usr/lib/jvm/*/bin/java "$HOME"/.sdkman/candidates/java/*/bin/java "$HOME"/.jdks/*/bin/java 2>/dev/null)"
    if printf 'x\n' | sort -rV >/dev/null 2>&1; then
        out="$(printf '%s\n' "$out" | sort -rV)"
    else
        out="$(printf '%s\n' "$out" | sort -r)"
    fi
    printf '%s\n' "$out"
}

FX_CANDS=()
_fx_discovered=0
canon_dir() {
    ( CDPATH= cd -- "$1" 2>/dev/null && pwd -P ) || printf '%s' "$1"
}
canon_file() {
    readlink -f "$1" 2>/dev/null || printf '%s/%s' "$(canon_dir "$(dirname "$1")")" "$(basename "$1")"
}
add_fx_dir() {
    local dir canon existing
    [ -n "${1:-}" ] || return 0
    [ -f "$1/javafx.controls.jar" ] || return 0
    canon="$(canon_dir "$1")"
    for existing in ${FX_CANDS[@]+"${FX_CANDS[@]}"}; do
        [ "$existing" = "$canon" ] && return 0
    done
    FX_CANDS+=("$canon")
    return 0
}
discover_fx() {
    [ "$_fx_discovered" = 1 ] && return 0
    _fx_discovered=1
    local c
    if [ -n "${JAVAFX_LIB:-}" ]; then
        add_fx_dir "$JAVAFX_LIB"
        return 0
    fi
    for c in /usr/lib/jvm/*openjfx*/lib /usr/share/openjfx/lib /usr/lib/openjfx/lib \
             /usr/lib64/openjfx/lib /usr/share/openjfx/lib64 /usr/share/java/openjfx/lib \
             /usr/lib64/jvm/*/lib \
             "${XDG_DATA_HOME:-$HOME/.local/share}"/blockpulse-launcher/javafx/lib; do
        add_fx_dir "$c"
    done
    [ "${#FX_CANDS[@]}" -gt 0 ] && return 0
    if command -v pacman >/dev/null 2>&1; then
        local pkg
        for pkg in $(pacman -Qqs openjfx 2>/dev/null); do
            while IFS= read -r c; do
                add_fx_dir "$(dirname "$c")"
            done < <(pacman -Ql "$pkg" 2>/dev/null | awk '$2 ~ /javafx\.controls\.jar$/ {print $2}')
        done
    elif command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W -f='${Status}\n' openjfx 2>/dev/null | grep -q 'install ok installed'; then
        while IFS= read -r c; do
            add_fx_dir "$(dirname "$c")"
        done < <(dpkg -L openjfx 2>/dev/null | awk '/\/javafx\.controls\.jar$/ {print}')
    elif command -v rpm >/dev/null 2>&1; then
        while IFS= read -r c; do
            add_fx_dir "$(dirname "$c")"
        done < <(rpm -qa --qf '%{NAME}\n' 2>/dev/null | grep -ixE 'openjfx|java-[0-9]+-openjfx' \
                 | while IFS= read -r pkg; do rpm -ql "$pkg" 2>/dev/null; done \
                 | awk -F/ '$NF == "javafx.controls.jar" {print}')
    fi
    return 0
}

PAIR_JAVA=()
PAIR_FXARGS=()
PAIR_NATIVE=()
PAIR_STABLE=()
MAX_PAIRS="${BLOCKPULSE_MAX_PAIRS:-2}"

add_pair() {
    [ "${#PAIR_JAVA[@]}" -ge "$MAX_PAIRS" ] && return 1
    PAIR_JAVA+=("$1")
    PAIR_FXARGS+=("$2")
    PAIR_NATIVE+=("$3")
    PAIR_STABLE+=("$4")
    return 0
}

probe_pairs() {
    local java vout major fx_path native stable fxdir
    local -a candidates=()
    if [ -n "${BLOCKPULSE_JAVA:-}" ]; then
        candidates=("$BLOCKPULSE_JAVA")
    else
        [ -n "${JAVA_HOME:-}" ] && candidates+=("$JAVA_HOME/bin/java")
        while IFS= read -r java; do [ -n "$java" ] && candidates+=("$java"); done < <(list_jvms)
        java="$(command -v java 2>/dev/null || true)"
        [ -n "$java" ] && candidates+=("$java")
    fi
    local seen=' ' cpath
    local -a all_java=() all_fx=() all_nat=() all_st=()
    for java in "${candidates[@]}"; do
        [ -x "$java" ] || continue
        cpath="$(canon_file "$java")"
        case "$seen" in *" $cpath "*) continue ;; esac
        seen="$seen$cpath "
        vout="$(java_version_of "$java")"
        major="$(java_major_of "$vout")"
        [ -n "$major" ] && [ "$major" -ge 21 ] 2>/dev/null || continue
        stable=1
        looks_unstable "$vout" && stable=0
        fx_path=''
        native=''
        if "$java" --list-modules 2>/dev/null | grep -q '^javafx\.controls'; then
            native="$(fx_native_path "$(dirname "$java")/../lib" || true)"
        else
            discover_fx
            for fxdir in ${FX_CANDS[@]+"${FX_CANDS[@]}"}; do
                [ -n "$fxdir" ] || continue
                fx_path="$(fx_module_path "$fxdir")"
                [ -n "$fx_path" ] || continue
                if "$java" --module-path "$fx_path" --describe-module javafx.controls >/dev/null 2>&1; then
                    native="$(fx_native_path "$fxdir" || true)"
                    break
                fi
                fx_path=''
            done
            [ -n "$fx_path" ] || continue
            fx_path="--module-path $fx_path --add-modules javafx.controls,javafx.graphics"
        fi
        all_java+=("$java"); all_fx+=("$fx_path"); all_nat+=("$native"); all_st+=("$stable")
    done
    local pass=1 idx
    while [ "$pass" -ge 0 ]; do
        idx=0
        while [ "$idx" -lt "${#all_java[@]}" ]; do
            if [ "${all_st[$idx]}" = "$pass" ] && [ "${#PAIR_JAVA[@]}" -lt "$MAX_PAIRS" ]; then
                add_pair "${all_java[$idx]}" "${all_fx[$idx]}" "${all_nat[$idx]}" "$pass"
            fi
            idx=$((idx + 1))
        done
        pass=$((pass - 1))
    done
}

if [ "$MODE" = diagnose ]; then
    pair_count=0
    probe_pairs
    pair_count="${#PAIR_JAVA[@]}"
    echo "== BlockPulse Launcher diagnostics =="
    echo "-- system --"
    uname -a
    session_type="${XDG_SESSION_TYPE:-}"
    if [ -z "$session_type" ] && [ -S "/run/user/$(id -u)/wayland-0" ]; then
        session_type=wayland
    fi
    if [ -z "$session_type" ] && [ -n "${DISPLAY:-}" ]; then
        session_type=x11
    fi
    echo "session: type=${session_type:-unknown} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>} DISPLAY=${DISPLAY:-<unset>} GDK_BACKEND=${GDK_BACKEND:-<unset>}"
    echo "app: ${APP_DIR:-<missing>}"
    echo "language: $LANG_CODE"
    echo "port version: $PORT_VERSION"
    echo "launcher version: $LAUNCHER_VERSION"
    echo "heap seeded preference: $(sed -n 's/^ramGb=//p' "$PREFS_FILE" 2>/dev/null | head -1)"
    echo "-- java candidates (>=21, usable with a javafx) --"
    if [ "$pair_count" -eq 0 ]; then
        echo "  none found"
    else
        i=0
        while [ "$i" -lt "$pair_count" ]; do
            printf '  %s  fx-args="%s" native="%s" stable=%s\n' "${PAIR_JAVA[$i]}" "${PAIR_FXARGS[$i]}" "${PAIR_NATIVE[$i]}" "${PAIR_STABLE[$i]}"
            i=$((i + 1))
        done
    fi
    echo "-- javafx lib dirs found --"
    discover_fx
    if [ "${#FX_CANDS[@]}" -eq 0 ]; then echo "  none"; else printf '  %s\n' "${FX_CANDS[@]}"; fi
    echo "-- OpenGL (needs mesa-utils for glxinfo) --"
    if command -v glxinfo >/dev/null 2>&1; then
        glxinfo 2>/dev/null | grep -i -E 'direct rendering|OpenGL (vendor|renderer|version)'
    else
        echo "  glxinfo not installed (optional; Arch: sudo pacman -S mesa-utils, Debian/Ubuntu: sudo apt-get install mesa-utils)"
    fi
    echo "-- relevant packages --"
    if command -v pacman >/dev/null 2>&1; then
        seen_pkgs=' '
        for pkg in mesa libglvnd gtk3 gtk2 jre21-openjdk java21-openjfx xorg-xwayland; do
            resolved="$(pacman -Qq "$pkg" 2>/dev/null | head -1)"
            if [ -z "$resolved" ]; then
                echo "  $pkg: not installed"
                continue
            fi
            case "$seen_pkgs" in *" $resolved "*) continue ;; esac
            seen_pkgs="$seen_pkgs$resolved "
            printf '  %s %s\n' "$resolved" "$(pacman -Q "$resolved" 2>/dev/null | awk '{print $2}')"
        done
    elif command -v dpkg-query >/dev/null 2>&1; then
        for pkg in openjfx openjdk-21-jre openjdk-21-jdk xwayland mesa-utils libgtk-3-0; do
            info="$(dpkg-query -W -f='${Status}\t${Package}\t${Version}\n' "$pkg" 2>/dev/null)"
            case "$info" in
                *"install ok installed"*) printf '  %s\n' "$(printf '%s' "$info" | awk -F'\t' '{print $2" "$3}')" ;;
                *) echo "  $pkg: not installed" ;;
            esac
        done
    else
        echo "  package manager not available"
    fi
    echo "-- JavaFX native libraries (checked with the JDK library path) --"
    java_bin="$(command -v java 2>/dev/null || true)"
    jdk_lib=''
    if [ -n "$java_bin" ]; then
        java_real="$(readlink -f "$java_bin" 2>/dev/null || printf '%s' "$java_bin")"
        jdk_lib="$(dirname "$(dirname "$java_real")")/lib"
    fi
    for fx in ${FX_CANDS[@]+"${FX_CANDS[@]}"}; do
        [ -n "$fx" ] || continue
        checked=0
        missing_all=''
        for so in "$fx"/libglass.so "$fx"/libprism_*.so "$fx"/libjavafx_*.so "$fx"/libdecora_sse.so "$fx"/libfxplugins.so "$fx"/libavplugin.so "$fx"/libgstreamer-lite.so "$fx"/libjfxmedia.so; do
            [ -f "$so" ] || continue
            checked=$((checked + 1))
            miss="$(LD_LIBRARY_PATH="$fx${jdk_lib:+:$jdk_lib}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd "$so" 2>/dev/null | awk '/not found/ {print $1}' | sort -u | tr '\n' ' ')"
            [ -n "$miss" ] && missing_all="${missing_all}  $so: $miss"$'\n'
        done
        if [ "$checked" -eq 0 ]; then
            echo "  $fx: no JavaFX native libraries"
        elif [ -z "$missing_all" ]; then
            echo "  $fx: all dependencies resolved ($checked libraries)"
        else
            printf '%s' "$missing_all"
        fi
    done
    if [ "${#FX_CANDS[@]}" -eq 0 ]; then
        echo "  no JavaFX directory found"
    fi
    echo "-- cached working combination --"
    if [ -f "$GRAPHICS_CACHE" ]; then cat "$GRAPHICS_CACHE"; else echo "  none yet"; fi
    echo "== end of report =="
    exit 0
fi

