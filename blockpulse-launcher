    ""
)
PRESET_ARGS=(
    "--enable-native-access=javafx.graphics,ALL-UNNAMED"
    "-Dprism.order=sw --enable-native-access=javafx.graphics,ALL-UNNAMED"
    "-Dprism.order=es2 --enable-native-access=javafx.graphics,ALL-UNNAMED"
    "-Dprism.order=sw -Dprism.forceGPU=false --enable-native-access=javafx.graphics,ALL-UNNAMED"
    "-Djdk.gtk.version=2 --enable-native-access=javafx.graphics,ALL-UNNAMED"
)

GRAPHICS_FAILURE_RE='no suitable pipeline found|Error initializing QuantumRenderer|No toolkit found'
GRACE_SECONDS="${BLOCKPULSE_GRACE_SECONDS:-8}"
ATTEMPT_STABLE=0

terminate() {
    local pid="$1" i=0
    kill "$pid" 2>/dev/null
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
    fi
}

run_attempt() {
    local out="$1"; shift
    : >"$out"
    "$@" >"$out" 2>&1 &
    local pid=$! start=$SECONDS rc=0 stable=0
    ATTEMPT_STABLE=0
    while kill -0 "$pid" 2>/dev/null; do
        if grep -qE "$GRAPHICS_FAILURE_RE" "$out" 2>/dev/null; then
            sleep 0.2
            terminate "$pid"
            wait "$pid" 2>/dev/null
            return 2
        fi
        if [ $((SECONDS - start)) -ge "$GRACE_SECONDS" ]; then
            stable=1
            break
        fi
        sleep 0.2
    done
    if wait "$pid" 2>/dev/null; then rc=0; else rc=$?; fi
    grep -qE "$GRAPHICS_FAILURE_RE" "$out" 2>/dev/null && return 2
    [ "$stable" = 1 ] && ATTEMPT_STABLE=1
    return "$rc"
}

launch_with() {
    local java="$1" fxargs="$2" native="$3" envstr="$4" extra="$5" out="$6"
    local -a cmd=() fx_arr=() extra_arr=() env_arr=() opts_arr=()
    [ -n "$fxargs" ] && read -r -a fx_arr <<<"$fxargs"
    [ -n "$extra" ] && read -r -a extra_arr <<<"$extra"
    [ -n "$envstr" ] && read -r -a env_arr <<<"$envstr"
    [ -n "$native" ] && env_arr+=("LD_LIBRARY_PATH=$native${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}")
    [ -n "${BLOCKPULSE_JAVA_OPTS:-}" ] && read -r -a opts_arr <<<"${BLOCKPULSE_JAVA_OPTS}"
    cmd=(env)
    [ "${#env_arr[@]}" -gt 0 ] && cmd+=("${env_arr[@]}")
    cmd+=("$java")
    [ "${#fx_arr[@]}" -gt 0 ] && cmd+=("${fx_arr[@]}")
    cmd+=("${PREFS_ARGS[@]}" "${BASE_JVM_ARGS[@]}")
    [ "${#OFFLINE_ARGS[@]}" -gt 0 ] && cmd+=("${OFFLINE_ARGS[@]}")
    [ "${#extra_arr[@]}" -gt 0 ] && cmd+=("${extra_arr[@]}")
    [ "${#opts_arr[@]}" -gt 0 ] && cmd+=("${opts_arr[@]}")
    cmd+=("${CP_ARGS[@]}" "$MAIN_CLASS")
    [ "${#SCRIPT_ARGS[@]}" -gt 0 ] && cmd+=("${SCRIPT_ARGS[@]}")
    run_attempt "$out" "${cmd[@]}"
}

LOG="$STATE_DIR/launcher.log"
TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/blockpulse-launcher.XXXXXX")"
trap 'rm -f "$TMP_OUT"' EXIT

flush_output() {
    [ -s "$TMP_OUT" ] || return 0
    if [ -t 1 ]; then
        cat "$TMP_OUT"
    else
        if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || printf 0)" -gt 5242880 ]; then
            mv -f "$LOG" "$LOG.old" 2>/dev/null
        fi
        cat "$TMP_OUT" >>"$LOG" 2>/dev/null
    fi
}

try_and_report() {
    local java="$1" fxargs="$2" native="$3" envstr="$4" extra="$5"
    launch_with "$java" "$fxargs" "$native" "$envstr" "$extra" "$TMP_OUT"
    local rc=$?
    flush_output
    return "$rc"
}

write_cache() {
    local java="$1" fxargs="$2" native="$3" envstr="$4" extra="$5" tmp
    tmp="$GRAPHICS_CACHE.$$"
    {
        printf 'CACHED_JAVA=%q\n' "$java"
        printf 'CACHED_FXARGS=%q\n' "$fxargs"
        printf 'CACHED_NATIVE=%q\n' "$native"
        printf 'CACHED_ENV=%q\n' "$envstr"
        printf 'CACHED_EXTRA=%q\n' "$extra"
    } >"$tmp" 2>/dev/null && mv -f "$tmp" "$GRAPHICS_CACHE" 2>/dev/null
    chmod 600 "$GRAPHICS_CACHE" 2>/dev/null
    return 0
}

cache_valid() {
    CACHED_JAVA=''; CACHED_FXARGS=''; CACHED_NATIVE=''; CACHED_ENV=''; CACHED_EXTRA=''
    [ -f "$GRAPHICS_CACHE" ] || return 1
    . "$GRAPHICS_CACHE" 2>/dev/null || return 1
    [ -n "${CACHED_JAVA:-}" ] && [ -x "$CACHED_JAVA" ] || return 1
    if [ -n "${BLOCKPULSE_JAVA:-}" ] && [ "$BLOCKPULSE_JAVA" != "$CACHED_JAVA" ]; then
        return 1
    fi
    local fxpath='' jar
    fxpath="$(printf '%s' "${CACHED_FXARGS:-}" | sed -n 's/.*--module-path \([^ ]*\).*/\1/p')"
    if [ -n "$fxpath" ]; then
        local -a jar_list=()
        IFS=':' read -r -a jar_list <<<"$fxpath"
        for jar in "${jar_list[@]}"; do
            [ -f "$jar" ] || return 1
        done
    fi
    if [ -n "${CACHED_NATIVE:-}" ] && [ ! -d "$CACHED_NATIVE" ]; then
        return 1
    fi
    return 0
}

wayland_note() {
    [ -n "${WAYLAND_DISPLAY:-}" ] || return 0
    [ -n "${GDK_BACKEND:-}" ] && return 0
    [ -n "${DISPLAY:-}" ] && { export GDK_BACKEND=x11; return 0; }
    local hint=''
    if command -v apt-get >/dev/null 2>&1; then
        hint='sudo apt-get install xwayland'
    elif command -v dnf >/dev/null 2>&1 || command -v dnf5 >/dev/null 2>&1; then
        hint='sudo dnf install xorg-x11-server-Xwayland'
    else
        hint='sudo pacman -S xorg-xwayland'
    fi
    err "blockpulse-launcher: $(t xwayland) $hint"
    notify "$(t xwayland) $hint"
}

no_java_message() {
    local hint
    if command -v apt-get >/dev/null 2>&1; then
        if [ "${#FX_CANDS[@]}" -eq 0 ]; then
            hint='sudo apt-get install openjdk-21-jre openjfx'
        else
            hint='sudo apt-get install openjdk-21-jre'
        fi
    elif command -v dnf >/dev/null 2>&1 || command -v dnf5 >/dev/null 2>&1; then
        hint='sudo dnf install java-21-openjdk openjfx'
    else
        hint='sudo pacman -S jdk21-openjdk java21-openjfx'
    fi
    err "blockpulse-launcher: $(t java_missing) $hint"
}

if cache_valid; then
    try_and_report "$CACHED_JAVA" "$CACHED_FXARGS" "$CACHED_NATIVE" "$CACHED_ENV" "$CACHED_EXTRA"
    rc=$?
    if [ "$rc" = 0 ]; then exit 0; fi
    if [ "$rc" != 2 ]; then exit "$rc"; fi
    rm -f "$GRAPHICS_CACHE"
    [ "$QUIET" = 1 ] || err "blockpulse-launcher: $(t cached_broken)"
fi

probe_pairs

if [ "${#PAIR_JAVA[@]}" -eq 0 ]; then
    saw_java=0
    while IFS= read -r c; do
        [ -x "$c" ] || continue
        v="$(java_version_of "$c")"
        m="$(java_major_of "$v")"
        if [ -n "$m" ] && [ "$m" -ge 21 ] 2>/dev/null; then saw_java=1; break; fi
    done < <(list_jvms)
    if [ "$saw_java" = 0 ] && command -v java >/dev/null 2>&1; then
        v="$(java_version_of "$(command -v java)")"
        m="$(java_major_of "$v")"
        [ -n "$m" ] && [ "$m" -ge 21 ] 2>/dev/null && saw_java=1
    fi
    discover_fx
    if [ "$saw_java" = 0 ]; then
        no_java_message
    elif [ "${#FX_CANDS[@]}" -eq 0 ]; then
        if command -v apt-get >/dev/null 2>&1; then hint='sudo apt-get install openjfx'
        elif command -v dnf >/dev/null 2>&1 || command -v dnf5 >/dev/null 2>&1; then hint='sudo dnf install openjfx'
        else hint='sudo pacman -S java21-openjfx'; fi
        err "blockpulse-launcher: $(t fx_missing) $hint"
        notify "$(t fx_missing) $hint"
    else
        err "blockpulse-launcher: $(t fx_mismatch) ${FX_CANDS[*]}"
        notify "$(t fx_mismatch)"
    fi
    exit 1
fi

wayland_note

if [ "${BLOCKPULSE_NO_RETRY:-0}" = "1" ]; then
    try_and_report "${PAIR_JAVA[0]}" "${PAIR_FXARGS[0]}" "${PAIR_NATIVE[0]}" "" "--enable-native-access=javafx.graphics,ALL-UNNAMED"
    exit $?
fi

i=0
while [ "$i" -lt "${#PAIR_JAVA[@]}" ]; do
    java="${PAIR_JAVA[$i]}"
    fxargs="${PAIR_FXARGS[$i]}"
    p=0
    while [ "$p" -lt "${#PRESET_ARGS[@]}" ]; do
        try_and_report "$java" "$fxargs" "${PAIR_NATIVE[$i]}" "${PRESET_ENV[$p]}" "${PRESET_ARGS[$p]}"
        rc=$?
        if [ "$rc" != 2 ]; then
            if [ "$rc" = 0 ] || [ "$ATTEMPT_STABLE" = 1 ]; then
                write_cache "$java" "$fxargs" "${PAIR_NATIVE[$i]}" "${PRESET_ENV[$p]}" "${PRESET_ARGS[$p]}"
            fi
            exit "$rc"
        fi
        p=$((p + 1))
    done
    i=$((i + 1))
done

msg="$(t graphics_failed) Log: $LOG"
err "blockpulse-launcher: $msg"
notify "$msg"
exit 1
