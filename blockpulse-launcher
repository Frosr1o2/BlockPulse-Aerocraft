LANG_CODE="${BLOCKPULSE_LANG:-}"
if [ -z "$LANG_CODE" ] && [ -r "$CONF_DIR/language" ]; then
    LANG_CODE="$(head -n1 "$CONF_DIR/language" 2>/dev/null)"
fi
if [ -z "$LANG_CODE" ]; then
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        uk*|UK*|ua*|UA*) LANG_CODE=uk ;;
        ru*|RU*) LANG_CODE=ru ;;
        en*|EN*) LANG_CODE=en ;;
        *) LANG_CODE=en ;;
    esac
fi
case "$LANG_CODE" in
    uk|ua|UK|UA) LANG_CODE=uk ;;
    ru|RU) LANG_CODE=ru ;;
    *) LANG_CODE=en ;;
esac

