OFFLINE_ARGS=()

backend_offline() {
    local marker="$STATE_DIR/backend-offline" stamp now
    stamp="$(head -n1 "$marker" 2>/dev/null)"
    case "$stamp" in
        ''|*[!0-9]*) stamp=0 ;;
    esac
    now="$(date +%s)"
    if [ $((now - stamp)) -lt 600 ]; then
        return 0
    fi
    command -v curl >/dev/null 2>&1 || return 1
    if curl -fsS -o /dev/null -m "${BLOCKPULSE_PROBE_TIMEOUT:-0.6}" "$BOOTSTRAP_URL" 2>/dev/null; then
        rm -f "$marker" 2>/dev/null
        return 1
    fi
    printf '%s\n' "$now" >"$marker" 2>/dev/null
    return 0
}

